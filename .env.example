# =============================================================================
# SecureVault - Environment Configuration Template
# DO NOT commit the actual .env file with sensitive secrets to version control!
# =============================================================================

# Server Port
PORT=3000

# Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Session Secret:
# MUST be a cryptographically random, high-entropy secret string in production.
# Example generation command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-cryptographically-strong-secret-in-production

# Password Hashing Cost Factor (Bcrypt rounds, default: 12)
BCRYPT_ROUNDS=12

# Session Lifetime in milliseconds (Default: 30 minutes = 1800000 ms)
SESSION_MAX_AGE_MS=1800000

# Cookie Security (Set to 'true' in production or behind HTTPS reverse proxy)
COOKIE_SECURE=false

# Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
